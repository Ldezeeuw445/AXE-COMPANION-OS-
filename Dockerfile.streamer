# AXE MetaAPI streamer — builds from monorepo root (no Railway Root Directory needed).
# Used by node/metaapi-streamer/railway.json → dockerfilePath: "Dockerfile.streamer"

FROM node:22-alpine AS builder
WORKDIR /app
COPY node/metaapi-streamer/package.json node/metaapi-streamer/package-lock.json* node/metaapi-streamer/tsconfig.json ./
RUN npm install
COPY node/metaapi-streamer/src ./src
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY node/metaapi-streamer/package.json node/metaapi-streamer/package-lock.json* ./
RUN npm install --omit=dev
COPY --from=builder /app/dist ./dist
ENV NODE_ENV=production
EXPOSE 8080
CMD ["node", "--enable-source-maps", "dist/index.js"]
