# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
.DS_Store?
._*
**/._*
*.pem

# local / tooling (do not ship)
.cursor/
.local/
.config/
*.zip
Icon?
skills-lock.json

# Replit / agent / design dumps — not needed for Vercel production
.replit
replit.md
.agents/
.canvas/
attached_assets/
artifacts/
exports/
screenshots/
app-icons/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local
supabase/.temp/

# Cloudflare build artifacts
cloudflare/*/.wrangler/
cloudflare/*/bun.lock

# Tauri desktop-app
src-tauri/target/
src-tauri/binaries/
src-tauri/resources/
src-tauri/gen/

# OpenNext build output
.open-next/
