# Copy to `.env.local` for local Vite. Never commit real values.
#
# --- AXE standalone (`npm run dev:axe` / `build:axe`) ---
# VITE_APP_MODE=axe
# Next.js Companion (QR + “Get AXE Companion” + /settings bridge). Must match production host:
# VITE_AXE_COMPANION_URL=https://www.axecompanion.com/chat
#
# Optional: hide the “Free AI” meter for EVERYONE on this build and skip local bumps (dev only).
# For production, prefer per-user unlimited in Supabase instead (see below).
# VITE_AXE_AI_UNLIMITED=true
#
# Per-user unlimited chat (you + testers): migration `20260503120000_axe_chat_quota_exempt.sql` adds
# `axe_user_entitlements.chat_quota_exempt`. In Supabase SQL editor (replace UUID):
#   INSERT INTO public.axe_user_entitlements (user_id, plan, chat_quota_exempt)
#   VALUES ('<auth.users.id uuid>', 'free', true)
#   ON CONFLICT (user_id) DO UPDATE SET chat_quota_exempt = EXCLUDED.chat_quota_exempt;
# The Vite /app pill calls `axe_chat_quota_status` and shows “Unlimited (tester)” when exempt.
#
# --- Public / safe in the browser bundle ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Use Supabase Edge for market data (recommended). Provider API keys go ONLY in
# Supabase Dashboard → Edge Functions → Secrets (engine-proxy, intel-proxy), NOT here.
VITE_USE_ENGINE_EDGE=true

# Optional: override default …/functions/v1/engine-proxy
# VITE_ENGINE_PROXY_URL=https://YOUR_PROJECT.supabase.co/functions/v1/engine-proxy

# Optional: trading terminal / live chart WebSocket (public URL only)
# VITE_LIVE_ENGINE_WS_URL=wss://…
# VITE_TRADING_TERMINAL_API_URL=https://…

# Intel map: set false in production if you do not want Hormuz-style demo overlays unless explicitly enabled
# VITE_VESSEL_FEED_LIVE=true

# --- Local dev WITHOUT Edge only (keys end up in the client bundle — not for production) ---
# If VITE_USE_ENGINE_EDGE is not true, you may set these for in-browser createEngine():
# VITE_FMP_API_KEY=
# VITE_FRED_API_KEY=
# VITE_POLYGON_API_KEY=
# VITE_TWELVEDATA_API_KEY=
