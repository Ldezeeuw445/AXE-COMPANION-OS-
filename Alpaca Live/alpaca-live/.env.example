# Core broker hub
BROKER_HUB_ENCRYPTION_KEY=replace_me
BROKER_HUB_DEFAULT_BROKER=mt5

# Alpaca live / paper API key mode
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=

# Alpaca OAuth / Connect mode
ALPACA_OAUTH_CLIENT_ID=
ALPACA_OAUTH_CLIENT_SECRET=
ALPACA_OAUTH_REDIRECT_URI=
ALPACA_OAUTH_SCOPES=account:write trading data
ALPACA_OAUTH_AUTHORIZE_URL=https://app.alpaca.markets/oauth/authorize
ALPACA_OAUTH_TOKEN_URL=https://authx.alpaca.markets/v1/oauth2/token

# API routing
ALPACA_TRADING_URL_LIVE=https://api.alpaca.markets
ALPACA_TRADING_URL_PAPER=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_STREAM_URL_LIVE=wss://api.alpaca.markets/stream
ALPACA_STREAM_URL_PAPER=wss://paper-api.alpaca.markets/stream

# Optional operational controls
ALPACA_HTTP_TIMEOUT_MS=15000
ALPACA_RETRY_COUNT=3
ALPACA_RATE_LIMIT_PER_USER=10
ALPACA_ENABLE_LIVE_TRADING=false
ALPACA_ENABLE_OAUTH_CONNECT=false
