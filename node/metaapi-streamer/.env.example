# ── MetaApi ──────────────────────────────────────────────────────────
# Same MetaApi token Vercel and the Cloudflare worker use.
METAAPI_TOKEN=

# ── Cloudflare ChartLiveRoom ────────────────────────────────────────
# Worker base URL (no trailing slash). Streamer POSTs to ${WORKER_URL}/internal/publish
WORKER_URL=https://axe-chart-edge.your-account.workers.dev

# Must match the Cloudflare `STREAMER_SECRET` you set with `wrangler secret put`.
STREAMER_SECRET=

# ── Supabase (required for dynamic mode) ────────────────────────────
# The streamer queries user_broker_accounts + assistant_memory_entries
# to discover accounts and watchlist symbols automatically.
SUPABASE_URL=https://pqnngpcgbdwxavbatbia.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Legacy static mode (optional) ──────────────────────────────────
# Set STATIC_MODE=true to use the old SUBSCRIPTIONS env var instead of Supabase.
# STATIC_MODE=false
# SUBSCRIPTIONS=userId|accountId|metaApiAccountId|XAUUSD|XAUUSDm|h1

# ── Logging ─────────────────────────────────────────────────────────
# error | warn | info | debug
LOG_LEVEL=info
