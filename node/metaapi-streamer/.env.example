# Same MetaApi token Vercel and the Cloudflare worker use.
METAAPI_TOKEN=

# Optional non-default region.
METAAPI_REGION=london

# Cloudflare worker base URL (no trailing slash). The streamer will POST to
# `${WORKER_URL}/internal/publish` with the X-Streamer-Secret header.
WORKER_URL=https://chart.example.com

# Must match the Cloudflare `STREAMER_SECRET` you set with `wrangler secret put`.
STREAMER_SECRET=

# Comma-separated room subscriptions: userId|accountId|metaApiAccountId|displaySymbol|brokerSymbol|tf
# Example: u_abc|acc_123|metaapi_xyz|XAUUSD|XAUUSDm|h1
SUBSCRIPTIONS=

# Optional log level: error | warn | info | debug
LOG_LEVEL=info
