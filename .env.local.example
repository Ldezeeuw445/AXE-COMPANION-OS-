# Copy to .env.local — use the same Supabase project as Trading OS if you share auth.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Must be exactly "supabase" for live data (not "true")
NEXT_PUBLIC_DATA_SOURCE=supabase

# Optional: where this app is hosted (QR, push metadata, Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:5001

# --- Stripe billing (server + public payment links) ---
# Run once: STRIPE_SECRET_KEY=sk_... node scripts/setup-stripe-billing.mjs
# STRIPE_SECRET_KEY=sk_live_... or sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_FOUNDER=price_...
# STRIPE_PRICE_ELITE=price_...
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK_FOUNDER=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK_ELITE=https://buy.stripe.com/...
# Legacy alias (Pro only): NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/...
# Optional: auto-register webhook when running setup script
# STRIPE_SETUP_CREATE_WEBHOOK=true

# Optional: comma-separated Supabase auth user UUIDs with full Companion access (owner/dev)
# AXE_FULL_ACCESS_USER_IDS=acff7a12-1111-481d-a7a9-cc07583b8069
# Alias: AXE_UNLIMITED_CHAT_USER_IDS also grants full access when AXE_FULL_ACCESS is unset

# Optional: skip chat quota RPC entirely (local dev only)
# AXE_SKIP_CHAT_QUOTA=true

# Optional: override secret for /migrations?key=... (copy-paste SQL UI). Default matches x-migration-secret on /api/internal/migrate
# AXE_MIGRATIONS_PAGE_SECRET=your-long-random-string

# Alpaca paper (server-only — enables real US equity bars on demo + Alpaca paper accounts)
# ALPACA_PAPER_API_KEY_ID=PK...   (preferred)
# ALPACA_PAPER_API_KEY=PK...      (alias also accepted)
# ALPACA_PAPER_API_SECRET_KEY=...
# ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets
