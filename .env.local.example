# Copy to .env.local — use the same Supabase project as Trading OS if you share auth.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Must be exactly "supabase" for live data (not "true")
NEXT_PUBLIC_DATA_SOURCE=supabase

# Optional: where this app is hosted (QR, push metadata)
NEXT_PUBLIC_APP_URL=http://localhost:5001

# ─────────────────────────────────────────────────────────────
# AI PROVIDER CONFIGURATION
# ─────────────────────────────────────────────────────────────
# Option A: Ollama (local LLM) — set this to use Ollama as primary provider
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Option B: OpenAI — used as fallback if Ollama fails, or as primary if OLLAMA_BASE_URL is not set
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# Optional: comma-separated Supabase auth user UUIDs with unlimited chat (no daily cap), for internal testing
# AXE_UNLIMITED_CHAT_USER_IDS=uuid-one,uuid-two

# Optional: skip chat quota RPC entirely (local dev only)
# AXE_SKIP_CHAT_QUOTA=true

# Optional: CoinGecko Demo/Pro API for wallet USD estimates (server-only)
# COINGECKO_API_KEY=your_demo_or_pro_key
# COINGECKO_API_PLAN=demo

# Optional: WalletConnect project ID for Trust / mobile wallet connect (public)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_cloud_project_id
